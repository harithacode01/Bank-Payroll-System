<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="BankPayrollSystem.SiteMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">
            Employee Payroll System
        </asp:ContentPlaceHolder>
    </title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f8;
            color: #333;
        }

        /* Header */
        .header {
            background-color: #1f4e78;
            color: white;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .subtitle {
            font-size: 14px;
            opacity: 0.9;
        }

        /* Navigation */
        .navbar {
            background-color: #173b5c;
            padding: 0;
        }

        .navbar ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
        }

        .navbar li {
            margin: 0;
        }

        .navbar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 20px;
            font-size: 15px;
        }

        .navbar a:hover {
            background-color: #2f75a8;
        }

        /* Main Content */
        .main-container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
            min-height: 500px;
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        /* Headings */
        h1, h2, h3 {
            color: #1f4e78;
        }

        /* Buttons */
        input[type="submit"],
        input[type="button"],
        button {
            background-color: #1f4e78;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 5px;
            cursor: pointer;
            margin: 5px;
        }

        input[type="submit"]:hover,
        input[type="button"]:hover,
        button:hover {
            background-color: #2f75a8;
        }

        /* Textboxes */
        input[type="text"],
        input[type="email"],
        input[type="date"],
        input[type="number"],
        select,
        textarea {
            padding: 9px;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: 100%;
            max-width: 500px;
            margin-bottom: 10px;
        }

        /* Tables */
        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            background-color: #1f4e78;
            color: white;
            padding: 10px;
        }

        td {
            padding: 10px;
            border: 1px solid #ddd;
        }

        tr:nth-child(even) {
            background-color: #f5f5f5;
        }

        /* Footer */
        .footer {
            background-color: #173b5c;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        .footer p {
            margin: 5px;
        }

        /* Mobile */
        @media (max-width: 700px) {

            .header {
                padding: 15px 20px;
                display: block;
                text-align: center;
            }

            .navbar ul {
                display: block;
            }

            .navbar a {
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.1);
            }

            .main-container {
                width: 95%;
                padding: 20px;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>

    <form id="form1" runat="server">

        <!-- Header -->
        <header class="header">

            <div class="logo">
                Employee Payroll System
            </div>

            <div class="subtitle">
                Employee & Salary Management
            </div>

        </header>

        <!-- Navigation -->
        <nav class="navbar">

            <ul>

                <li>
                    <a href="Default.aspx">Home</a>
                </li>

                <li>
                    <a href="Employees.aspx">Employees</a>
                </li>

                <li>
                    <a href="Payroll.aspx">Payroll</a>
                </li>

                <li>
                    <a href="ViewPayroll.aspx">View Payroll</a>
                </li>

                <li>
                    <a href="About.aspx">About</a>
                </li>

                <li>
                    <a href="Contact.aspx">Contact</a>
                </li>

            </ul>

        </nav>

        <!-- Main Content -->
        <main class="main-container">

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

        </main>

        <!-- Footer -->
        <footer class="footer">

            <p>
                © 2026 Employee Payroll System
            </p>

            <p>
                Employee Management | Payroll Management
            </p>

        </footer>

    </form>

</body>
</html>